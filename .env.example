# Copy to .env for local development. In K8s these come from a ConfigMap/Secret instead.

WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_DOWNLOAD_ROOT=/models
GPU_CONCURRENCY=1

MAX_UPLOAD_MB=500
SYNC_MAX_UPLOAD_MB=25

# key:label pairs, comma-separated. Give Open WebUI its own key so its usage
# is distinguishable in transcription_requests / logs from other callers.
API_KEYS_RAW=sk-changeme-local:local-dev,sk-changeme-openwebui:openwebui

DATABASE_URL=postgresql+asyncpg://fastwhisper:fastwhisper@localhost:5432/fastwhisper

LOG_LEVEL=INFO
LOG_JSON=false
